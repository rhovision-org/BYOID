# BYOID production environment for rhobot-2.
#
# Install as /etc/byoid/byoid.env, root:root, mode 0600. This file is the ONLY
# place provider secrets should live. Never copy it into the repository or the
# GitHub Pages build.
#
#   sudo install -d -m 0750 /etc/byoid
#   sudo install -m 0600 deploy/byoid.env.example /etc/byoid/byoid.env
#   sudo editor /etc/byoid/byoid.env
#   sudo systemctl restart byoid
#
# The service reads this via systemd EnvironmentFile. Existing environment
# variables win over values in a checked-out .env file.

NODE_ENV=production
HOST=127.0.0.1
PORT=3100
PUBLIC_URL=https://byoid.rhobot.net

# rholo target. The server pays phlo from its own generated deploy key; that
# key cannot sign as a BYOID user.
RHOLO_URL=https://playground.rhobot.net
CHAIN_WRITES=true
RHOLO_FAUCET=true

# auto: configured providers use live OAuth, unconfigured ones stay demo.
# off: unconfigured providers are disabled instead of simulated.
OAUTH_DEMO=auto

# Register these exact redirect URIs with each provider:
#   Google   https://byoid.rhobot.net/auth/google/callback
#   GitHub   https://byoid.rhobot.net/auth/github/callback
#   Facebook https://byoid.rhobot.net/auth/facebook/callback
#   Apple    https://byoid.rhobot.net/auth/apple/callback

# ── Provider credentials ────────────────────────────────────────────────────
# Uncomment only the providers that are configured. Use `npm run oauth:check`
# (run from /opt/byoid) to confirm modes and missing variable names. Do not
# print this file, `env`, or the service's process environment into logs/issues.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# FACEBOOK_CLIENT_ID=
# FACEBOOK_CLIENT_SECRET=

# Apple: APPLE_CLIENT_ID is the Services ID. Supply either a pre-generated
# APPLE_CLIENT_SECRET JWT or Team ID + Key ID + absolute path to the .p8 key.
# The private key file should be root-owned, mode 0600, outside the repo.
# APPLE_CLIENT_ID=
# APPLE_TEAM_ID=
# APPLE_KEY_ID=
# APPLE_PRIVATE_KEY_PATH=/etc/byoid/AuthKey_XXXXXXXXXX.p8
# APPLE_CLIENT_SECRET=

# Optional: use a specific funded playground deploy key instead of the key
# generated into /var/lib/byoid/deployer-key.json. Keep it out of argv/logs.
# RHOLO_DEPLOYER_PRIVATE_KEY=
