# ── BYOID POC ────────────────────────────────────────────────────────────────
# Everything here is optional. The app runs out of the box against the public
# rholo playground with simulated (demo) Google / GitHub / Facebook providers.

# Where the app listens. 127.0.0.1 keeps a local POC off your network.
HOST=127.0.0.1
PORT=3000

# Public origin used to build OAuth redirect URIs and DID service endpoints.
# For localhost this is http://localhost:3000.
PUBLIC_URL=http://localhost:3000

# rholo node. The default is the public playground dev chain (shard /playground).
RHOLO_URL=https://playground.rhobot.net
# Optional: override the shard discovered from /api/status (normally leave unset).
# RHOLO_SHARD=/playground

# Set to false to run the wallet/verifier UI without writing anything on-chain.
CHAIN_WRITES=true
# Anchor name prefix. Events live at "<prefix>:did:<method-specific-id>".
ANCHOR_PREFIX=byoid
# Ask the dev-mode faucet for test REV the first time the server writes a deploy.
RHOLO_FAUCET=true
# Optional pre-funded secp256k1 deployer private key (hex). If unset, a key is
# generated in data/deployer-key.json and funded from the playground faucet.
# RHOLO_DEPLOYER_PRIVATE_KEY=

# ── Real OAuth providers (optional) ─────────────────────────────────────────
# Leave a pair unset to use that provider in DEMO mode. Set both to use live OAuth.
# Redirect URIs to register:
#   Google:   http://localhost:3000/auth/google/callback
#   GitHub:   http://localhost:3000/auth/github/callback
#   Facebook: http://localhost:3000/auth/facebook/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# FACEBOOK_CLIENT_ID=
# FACEBOOK_CLIENT_SECRET=

# auto (default): live when credentials exist, demo otherwise.
# off: unconfigured providers are disabled instead of simulated.
# OAUTH_DEMO=auto
